<?xml version="1.0" encoding="utf-8"?>
<!-- 「今日碎片」小部件声明。
     targetCellWidth/Height、previewLayout、description 为 Android 12+ 属性，
     旧系统自动忽略，走 minWidth/minHeight + initialLayout。
     最小尺寸按启动器换算公式 70*cells-30 取 2x2 = 110x110dp —— 2 格宽是点阵 24 列的下限，
     再窄就糊成一团了；拖出来默认落在 3x2（targetCell*），可自由缩到 2x2、放到 4x3。
     FragmentsWidgetProvider 按实际尺寸重画点阵位图，并在窄宽档自动收掉放不下的统计行与标题
     （「更新于 HH:mm」常驻不隐藏）。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_fragments"
    android:previewLayout="@layout/widget_fragments"
    android:description="@string/widget_fragments_desc"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
