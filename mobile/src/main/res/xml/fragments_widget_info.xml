<?xml version="1.0" encoding="utf-8"?>
<!-- 「今日碎片」小部件声明。
     targetCellWidth/Height、previewLayout、description 为 Android 12+ 属性，
     旧系统自动忽略，走 minWidth/minHeight + initialLayout。
     minWidth/minHeight 按启动器换算公式 70*cells-30 取 3x2 = 180x110dp（点阵 24 列，
     太窄就糊成一团），可拖拽放大到 4x3；FragmentsWidgetProvider 按实际尺寸重画点阵位图。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_fragments"
    android:previewLayout="@layout/widget_fragments"
    android:description="@string/widget_fragments_desc"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
