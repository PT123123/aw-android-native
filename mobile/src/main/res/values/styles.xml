<resources>

    <!--
      Base application theme.
      DayNight：深浅两套资源随 AppCompatDelegate 的 night mode 切换。
      AWApplication 在启动时强制 MODE_NIGHT_YES，故本 app 恒为深色外观
      （values-night/colors.xml 提供实际取值）。
    -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- colorPrimary 是白色，默认 MaterialButton 文字也是白色会不可见 -->
        <item name="colorOnPrimary">@color/default_text_color</item>
        <item name="materialAlertDialogTheme">@style/AppAlertDialogTheme</item>

        <!-- Material 语义色：让 Card / Chip / Dialog / Tab 自动跟随主题 -->
        <item name="colorSurface">@color/aw_surface</item>
        <item name="colorOnSurface">@color/aw_text_primary</item>
        <item name="colorSecondary">@color/aw_accent</item>
        <item name="colorOnSecondary">@color/aw_surface</item>
        <item name="colorError">@color/aw_danger</item>

        <!-- 窗口与系统栏 -->
        <item name="android:colorBackground">@color/aw_bg</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/aw_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/aw_bg</item>

        <!-- 文字与图标 -->
        <item name="android:textColor">@color/default_text_color</item>
        <item name="android:textColorPrimary">@color/aw_text_primary</item>
        <item name="android:textColorSecondary">@color/aw_text_secondary</item>
        <item name="android:textColorTertiary">@color/aw_text_disabled</item>
        <item name="colorControlNormal">@color/aw_text_secondary</item>
    </style>

    <!-- 评论等 Material 对话框使用深色外观，与 Inbox 界面一致 -->
    <style name="AppAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/inbox_card</item>
        <item name="colorOnSurface">@color/inbox_text</item>
        <item name="colorPrimary">@color/inbox_accent</item>
    </style>
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.DayNight"/>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.DayNight"/>

    <!-- Inbox 编辑笔记 BottomSheet 主题 -->
    <style name="InboxBottomSheetDialogTheme" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/InboxBottomSheetStyle</item>
    </style>

    <!-- Inbox 卡片三点菜单：黑底白字 -->
    <style name="InboxPopupMenu" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="colorSurface">@color/inbox_card</item>
        <item name="colorOnSurface">@color/inbox_text</item>
        <item name="android:colorBackground">@color/inbox_bg</item>
        <item name="android:textColor">@color/inbox_text</item>
    </style>

    <style name="InboxBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Inbox 设置滑条的气泡标签 -->
    <style name="InboxSliderLabel" parent="Widget.MaterialComponents.Tooltip">
        <item name="backgroundTint">@color/inbox_accent</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- ============================================================
         活动（Activity）模块通用样式
         统一引用语义色，新增界面直接套用即可自动适配深/浅主题。
         ============================================================ -->

    <!-- 内容卡片：深色下阴影不可见，改用 1dp 描边划分层次 -->
    <style name="AwCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/aw_surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="contentPadding">12dp</item>
        <item name="strokeColor">@color/aw_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 卡片内小节标题 -->
    <style name="AwSectionTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/aw_text_primary</item>
    </style>

    <style name="AwBody">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/aw_text_secondary</item>
    </style>

    <!-- 时间范围选择 Chip：选中态用 accent，未选中用 surface_2 -->
    <style name="AwChipChoice" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/aw_chip_bg_selector</item>
        <item name="android:textColor">@color/aw_chip_text_selector</item>
        <item name="chipStrokeColor">@color/aw_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <!-- 选中只靠底色区分；Choice 默认会画个深色对勾，深色主题下反而看不清 -->
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- 等宽文本：Query Explorer 的查询输入与 JSON 结果 -->
    <style name="AwMonoText">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/aw_text_primary</item>
    </style>

    <!-- 主操作按钮：accent 实心，深色下不再依赖 colorPrimary（它是深灰，不醒目） -->
    <style name="AwButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/aw_accent</item>
        <item name="android:textColor">@color/aw_bg</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- 次操作按钮：描边 + 透明底 -->
    <style name="AwButtonSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/aw_border</item>
        <item name="android:textColor">@color/aw_text_primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- 输入框：深色下 EditText 默认文字是黑的，必须显式给定颜色 -->
    <style name="AwEditText">
        <item name="android:textColor">@color/aw_text_primary</item>
        <item name="android:textColorHint">@color/aw_text_disabled</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/aw_field_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- ============================================================
         Todo（任务）模块通用样式
         ============================================================ -->

    <!-- 详情页的「标签 + 值」行（点击弹出选择器） -->
    <style name="TodoDetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="TodoDetailLabel">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/aw_text_primary</item>
    </style>

    <style name="TodoDetailValue">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/aw_text_secondary</item>
    </style>

    <!-- 任务详情：手机上没有第三栏，用全屏对话框代替右栏详情面板 -->
    <style name="TodoFullScreenDialog" parent="AppTheme">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/aw_bg</item>
    </style>

</resources>
