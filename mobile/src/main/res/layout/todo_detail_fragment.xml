<?xml version="1.0" encoding="utf-8"?>
<!--
  任务详情面板（契约 §5.6）。
  桌面端是三栏布局里的右栏；手机上没有第三栏，这里做成全屏 DialogFragment，
  返回键 / 左上角 ✕ 关闭，字段提交时机与桌面端一致（详见 TodoDetailFragment 注释）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aw_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/detailToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/aw_bg"
        app:menu="@menu/menu_todo_detail"
        app:navigationIcon="@drawable/ic_close"
        app:navigationIconTint="@color/aw_text_primary"
        app:subtitleTextColor="@color/aw_text_secondary"
        app:title="任务详情"
        app:titleTextColor="@color/aw_text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- 标题：失焦 / 回车提交 -->
            <EditText
                android:id="@+id/detailTitle"
                style="@style/AwEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="任务标题"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="16sp" />

            <!-- 已完成：点击即时生效 -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/detailDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="已完成"
                android:textColor="@color/aw_text_primary"
                android:textSize="14sp"
                app:buttonTint="@color/aw_accent" />

            <!-- 清单 -->
            <LinearLayout
                android:id="@+id/rowList"
                style="@style/TodoDetailRow">

                <TextView
                    style="@style/TodoDetailLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="清单" />

                <TextView
                    android:id="@+id/detailListValue"
                    style="@style/TodoDetailValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 优先级 -->
            <LinearLayout
                android:id="@+id/rowPriority"
                style="@style/TodoDetailRow">

                <TextView
                    style="@style/TodoDetailLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="优先级" />

                <TextView
                    android:id="@+id/detailPriorityValue"
                    style="@style/TodoDetailValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 截止日期：勾选 + 日期选择（未勾选则无期限、日期禁用） -->
            <LinearLayout
                android:id="@+id/rowDue"
                style="@style/TodoDetailRow">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/detailDueCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="截止"
                    android:textColor="@color/aw_text_primary"
                    android:textSize="14sp"
                    app:buttonTint="@color/aw_accent" />

                <TextView
                    android:id="@+id/detailDueValue"
                    style="@style/TodoDetailValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- 重复（本地源支持；REST 源不支持，代码里会隐藏） -->
            <LinearLayout
                android:id="@+id/rowRecurrence"
                style="@style/TodoDetailRow">

                <TextView
                    style="@style/TodoDetailLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="重复" />

                <TextView
                    android:id="@+id/detailRecurrenceValue"
                    style="@style/TodoDetailValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 标签：逗号（中英文皆可）分隔，失焦 / 回车提交 -->
            <EditText
                android:id="@+id/detailTags"
                style="@style/AwEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="标签，用逗号分隔"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1" />

            <!-- 备注：250ms 防抖提交 -->
            <EditText
                android:id="@+id/detailNotes"
                style="@style/AwEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:hint="备注"
                android:inputType="textMultiLine"
                android:minLines="4" />

            <!-- 子任务 -->
            <LinearLayout
                android:id="@+id/subtaskSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="子任务"
                    android:textColor="@color/aw_text_secondary"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/subtaskList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <LinearLayout
                    android:id="@+id/subtaskInputRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/subtaskInput"
                        style="@style/AwEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="添加子任务，回车确认"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLines="1" />

                    <ImageButton
                        android:id="@+id/subtaskAdd"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="添加子任务"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="@color/aw_accent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/subtaskHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="当前数据源（服务器）暂不支持子任务"
                    android:textColor="@color/aw_text_disabled"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 删除：危险操作，弹确认框 -->
            <Button
                android:id="@+id/detailDelete"
                style="@style/AwButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="删除任务"
                android:textColor="@color/aw_danger" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
