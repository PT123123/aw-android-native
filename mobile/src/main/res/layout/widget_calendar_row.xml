<?xml version="1.0" encoding="utf-8"?>
<!-- 日历日期行。height=0dp + weight=1：由父容器 ll_cal_grid（已 weight=1）把可用高度
     等分给各行，行高的不确定性全部由这里吸收——字号估小了也不会把最后一行挤到部件
     外面；行比字高时文本垂直居中，不会出现底部留白。颜色/字号由代码设置。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/cell_0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="0dp"
        android:gravity="center"
        android:minHeight="0dp"
        android:textSize="9sp"
        android:maxLines="1"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/cell_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="0dp"
        android:gravity="center"
        android:minHeight="0dp"
        android:textSize="9sp"
        android:maxLines="1"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/cell_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="0dp"
        android:gravity="center"
        android:minHeight="0dp"
        android:textSize="9sp"
        android:maxLines="1"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/cell_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="0dp"
        android:gravity="center"
        android:minHeight="0dp"
        android:textSize="9sp"
        android:maxLines="1"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/cell_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="0dp"
        android:gravity="center"
        android:minHeight="0dp"
        android:textSize="9sp"
        android:maxLines="1"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/cell_5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="0dp"
        android:gravity="center"
        android:minHeight="0dp"
        android:textSize="9sp"
        android:maxLines="1"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/cell_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="0dp"
        android:gravity="center"
        android:minHeight="0dp"
        android:textSize="9sp"
        android:maxLines="1"
        android:includeFontPadding="false" />
</LinearLayout>
