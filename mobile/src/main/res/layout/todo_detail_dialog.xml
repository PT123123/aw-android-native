<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inbox_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/dlgTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/inbox_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/todo_input_bg"
            android:hint="标题"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="2"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/inbox_text"
            android:textColorHint="@color/inbox_sub"
            android:textSize="16sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/dDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="已完成"
            android:textColor="@color/inbox_text"
            app:buttonTint="@color/inbox_accent" />

        <!-- 清单（点击弹单选） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="清单"
                android:textColor="@color/inbox_sub"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dListValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/todo_input_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/inbox_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 优先级（点击弹单选） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="优先级"
                android:textColor="@color/inbox_sub"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dPriorityValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/todo_input_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/inbox_text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 截止日期（点击弹 DatePicker；右侧清除） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="截止日期"
                android:textColor="@color/inbox_sub"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dDueValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/todo_input_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/inbox_text"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/dDueClear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="清除截止日期"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/inbox_sub" />
        </LinearLayout>

        <EditText
            android:id="@+id/dTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/todo_input_bg"
            android:hint="标签（空格分隔）"
            android:inputType="text"
            android:maxLines="2"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/inbox_text"
            android:textColorHint="@color/inbox_sub"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/dNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/todo_input_bg"
            android:gravity="top|start"
            android:hint="备注"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/inbox_text"
            android:textColorHint="@color/inbox_sub"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dDelete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="删除"
                android:textColor="@color/inbox_accent"
                app:strokeColor="@color/inbox_accent" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/inbox_accent" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
