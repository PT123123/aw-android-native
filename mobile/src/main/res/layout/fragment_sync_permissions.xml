<?xml version="1.0" encoding="utf-8"?>
<!-- 同步权限 / 保活设置页：列出局域网自动同步所需的系统权限，并跳转到对应设置项 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aw_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/aw_bg"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/aw_text_primary"
            app:title="同步权限 / 保活"
            app:titleTextColor="@color/aw_text_primary" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 说明 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/AwCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AwSectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="为什么需要这些权限" />

                        <TextView
                            style="@style/AwBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="局域网同步依靠应用内常驻的同步服务：它要能在后台收发广播、按频率双向同步。手机厂商（尤其小米 HyperOS / MIUI）默认会冻结或回收后台应用，一旦被回收，同步服务随之消失、自动同步就停了，只有重新打开应用才会恢复。\n\n下面每一项都只影响后台运行能力，不影响隐私数据。" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 后台运行（保活） -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/AwCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AwSectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="后台运行（保活）" />

                        <TextView
                            android:id="@+id/tvServiceStatus"
                            style="@style/AwBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="检测中…" />

                        <!-- 忽略电池优化 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="电池优化 → 无限制"
                                    android:textColor="@color/aw_text_primary"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvBatteryStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="检测中…"
                                    android:textColor="@color/aw_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBattery"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="去设置"
                                android:textColor="@color/aw_accent" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/aw_divider" />

                        <!-- 自启动 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="自启动 / 后台启动"
                                    android:textColor="@color/aw_text_primary"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvAutoStartStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="厂商专有开关，需手动确认"
                                    android:textColor="@color/aw_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAutoStart"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="去设置"
                                android:textColor="@color/aw_accent" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/aw_divider" />

                        <!-- 应用详情兜底 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="应用详情（省电策略 / 后台限制）"
                                    android:textColor="@color/aw_text_primary"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="各家 ROM 入口不同，这里是通用兜底"
                                    android:textColor="@color/aw_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAppDetails"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="打开"
                                android:textColor="@color/aw_accent" />
                        </LinearLayout>

                        <TextView
                            style="@style/AwBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="HyperOS / MIUI 额外一步：在「最近任务」里下拉本应用卡片 → 点锁图标「锁定」，防止一键清理时被连带杀掉。" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 通知 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/AwCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AwSectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="通知" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="允许通知"
                                    android:textColor="@color/aw_text_primary"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvNotificationStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="检测中…"
                                    android:textColor="@color/aw_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNotification"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="去设置"
                                android:textColor="@color/aw_accent" />
                        </LinearLayout>

                        <TextView
                            style="@style/AwBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="通知权限主要影响任务的到点提醒；若后续启用「常驻前台服务」保活，它也是一项前置条件。" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 网络 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/AwCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/AwSectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="网络" />

                        <TextView
                            android:id="@+id/tvWifiStatus"
                            style="@style/AwBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="检测中…" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnWifiSettings"
                                style="@style/AwButtonSecondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wi-Fi 设置" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnWifiIpSettings"
                                style="@style/AwButtonSecondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="高级设置（休眠/静态 IP）" />
                        </LinearLayout>

                        <TextView
                            style="@style/AwBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="若本机 IP 频繁变化，可在此把 Wi-Fi 设为静态 IP —— 对端设备记录里的地址会一直有效，同步最稳。" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefresh"
                    style="@style/AwButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="刷新状态" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
