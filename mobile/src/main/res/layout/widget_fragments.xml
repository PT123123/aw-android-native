<?xml version="1.0" encoding="utf-8"?>
<!-- 「今日碎片」小部件：标题行 + 当天 24 时 × 5 分钟点阵热力（一张位图）+ 推断作息。
     点阵由 FragmentsWidgetProvider 画成位图推送（RemoteViews 塞不下 288 个 View），
     ImageView 用 fitXY 撑满剩余空间；位图按部件实际尺寸重画，缩放后不该有明显模糊。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_fragments_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/ll_frag_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_frag_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="13sp"
            android:text="@string/widget_fragments_label"
            android:textSize="13sp"
            android:textColor="@color/widget_text_secondary" />

        <!-- 「更新于 HH:mm」：窄宽档（2×2）标题收起时靠标题占住的权重空白保持在右上角，
             位置不随尺寸变化；放不下时由 ellipsize 兜底，不做整块隐藏。 -->
        <TextView
            android:id="@+id/tv_frag_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_frag_heat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_fragments_label" />

    <!-- 「起床 … · 入睡 …」：常驻不隐藏。宽部件一行放得下，2 格宽放不下——
         那时由 provider 改送带换行的两行文案（见 widget_fragments_stats_stacked），
         所以 maxLines 必须留到 2；放不下才走 ellipsize 兜底。 -->
    <TextView
        android:id="@+id/tv_frag_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="12sp"
        android:textSize="12sp"
        android:textColor="@color/widget_text_secondary" />
</LinearLayout>
