<?xml version="1.0" encoding="utf-8"?>
<!-- 局域网同步页：两个可折叠面板（配对与设备 / 设置）；「显示报文」已拆为独立「同步详情」页 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inbox_bg"
    android:theme="@style/Theme.MaterialComponents">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/inbox_bg"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark"
            app:title="局域网同步"
            app:titleTextColor="@color/inbox_text"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/inbox_text" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/sync_link" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="在本地网络内与其他设备同步 Inbox / Todo 与 ActivityWatch 数据。"
                        android:textColor="@color/inbox_sub"
                        android:textSize="13sp" />

                    <!-- 实验性 WiFi 热点传输入口 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWifiTransfer"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="WiFi 热点传输（实验性）— 无路由器点对点同步"
                        android:textColor="@color/sync_link"
                        app:strokeColor="@color/sync_link" />

                    <!-- ========== 面板 1：配对与设备 ========== -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/sync_card"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/sync_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/peersHeader"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="配对与设备"
                                    android:textColor="@color/inbox_text"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/peersChevron"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:importantForAccessibility="no"
                                    android:src="@android:drawable/arrow_down_float"
                                    app:tint="@color/inbox_sub" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/peersContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="12dp">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/devicesList"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:nestedScrollingEnabled="false" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ========== 面板 2：设置 ========== -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/sync_card"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/sync_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/settingsHeader"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="设置"
                                    android:textColor="@color/inbox_text"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/settingsChevron"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:importantForAccessibility="no"
                                    android:rotation="0"
                                    android:src="@android:drawable/arrow_down_float"
                                    app:tint="@color/inbox_sub" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/settingsContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="16dp"
                                android:visibility="gone">

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/cfgEnabled"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="开启局域网同步"
                                    android:textColor="@color/inbox_text" />

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/cfgHttp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="使用 HTTP 同步"
                                    android:textColor="@color/inbox_text" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:layout_marginBottom="6dp"
                                    android:text="设备发现方式"
                                    android:textColor="@color/inbox_text"
                                    android:textStyle="bold" />

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <AutoCompleteTextView
                                        android:id="@+id/cfgDiscoveryMethod"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="none"
                                        android:textColor="@color/inbox_text"
                                        android:textSize="14sp" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="已实现「广播 / mDNS+UDP」自动发现；「轮询遍历」功能待后续迭代。"
                                    android:textColor="@color/inbox_sub"
                                    android:textSize="12sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:layout_marginBottom="6dp"
                                    android:text="同步端口 (HTTP)"
                                    android:textColor="@color/inbox_text"
                                    android:textStyle="bold" />

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/cfgListenPort"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:enabled="false"
                                        android:inputType="number"
                                        android:textColor="@color/inbox_sub"
                                        android:textSize="14sp" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="设备间同步 HTTP 端口，与服务器端口一致（固定 5600）。"
                                    android:textColor="@color/inbox_sub"
                                    android:textSize="12sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:layout_marginBottom="6dp"
                                    android:text="UDP 发现端口"
                                    android:textColor="@color/inbox_text"
                                    android:textStyle="bold" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilUdpPort"
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/cfgUdpPort"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="number"
                                        android:textColor="@color/inbox_text"
                                        android:textSize="14sp" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="广播 / mDNS+UDP 自动发现固定端口（默认 46000）。"
                                    android:textColor="@color/inbox_sub"
                                    android:textSize="12sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:layout_marginBottom="6dp"
                                    android:text="在线探测间隔 (秒)"
                                    android:textColor="@color/inbox_text"
                                    android:textStyle="bold" />

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilProbeInterval"
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/cfgProbeInterval"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="number"
                                        android:textColor="@color/inbox_text"
                                        android:textSize="14sp" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="已配对设备定时间隔探测在线状态（默认 10s）。"
                                    android:textColor="@color/inbox_sub"
                                    android:textSize="12sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:layout_marginBottom="6dp"
                                    android:text="同步目标"
                                    android:textColor="@color/inbox_text"
                                    android:textStyle="bold" />

                                <com.google.android.material.checkbox.MaterialCheckBox
                                    android:id="@+id/cfgSyncInbox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Inbox 数据 (inbox.db)"
                                    android:textColor="@color/inbox_text" />

                                <com.google.android.material.checkbox.MaterialCheckBox
                                    android:id="@+id/cfgSyncActivity"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="ActivityWatch 数据 (sqlite.db)"
                                    android:textColor="@color/inbox_text" />

                                <com.google.android.material.checkbox.MaterialCheckBox
                                    android:id="@+id/cfgSyncTodo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Todo 数据 (todo.db)"
                                    android:textColor="@color/inbox_text" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:layout_marginBottom="6dp"
                                    android:text="本机别名"
                                    android:textColor="@color/inbox_text"
                                    android:textStyle="bold" />

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/cfgSelfAlias"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="设置本机别名（为空则使用主机名）"
                                        android:maxLength="20"
                                        android:textColor="@color/inbox_text"
                                        android:textColorHint="@color/inbox_sub"
                                        android:textSize="14sp" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="广播时显示在对方设备列表中。"
                                    android:textColor="@color/inbox_sub"
                                    android:textSize="12sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSaveConfig"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="保存同步设置"
                                    app:backgroundTint="@color/sync_link" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginTop="16dp"
                                    android:background="@color/sync_border" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:layout_marginBottom="6dp"
                                    android:text="配对数据"
                                    android:textColor="@color/inbox_text"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnClearAll"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="清空所有配对信息"
                                    android:textColor="@color/sync_danger"
                                    app:strokeColor="@color/sync_danger" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="移除全部已配对 / 已发现的设备（不可恢复）"
                                    android:textColor="@color/inbox_sub"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
