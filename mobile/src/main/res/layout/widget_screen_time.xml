<?xml version="1.0" encoding="utf-8"?>
<!-- 「今日屏幕使用」小部件：标题行 + 大字时长 + 常用应用图例（RemoteViews 仅支持有限控件，
     图例圆点用固定尺寸的 TextView + 圆形背景实现）。
     文字全部启用 TextView 自适应（autoSizeTextType，API 26+；低版本退化为单行省略号），
     拖拽缩放时按实际可用空间自动缩放字号，不再写死尺寸导致溢出/遮挡。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_screen_time_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/ll_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="13sp"
            android:text="@string/widget_screen_time_label"
            android:textSize="13sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/tv_widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_widget_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="28sp"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary" />

    <LinearLayout
        android:id="@+id/ll_legend_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_dot_1" />

        <TextView
            android:id="@+id/tv_legend_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="12sp"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_legend_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_dot_2" />

        <TextView
            android:id="@+id/tv_legend_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="12sp"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_legend_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_dot_3" />

        <TextView
            android:id="@+id/tv_legend_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="12sp"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_legend_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_dot_4" />

        <TextView
            android:id="@+id/tv_legend_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="12sp"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_legend_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_dot_5" />

        <TextView
            android:id="@+id/tv_legend_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="12sp"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
</LinearLayout>
