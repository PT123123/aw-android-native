<?xml version="1.0" encoding="utf-8"?>
<!--
  查看 / 编辑笔记（同一个全屏页，两种状态，不再用弹出面板）：
  - 查看态：顶部显示该笔记真正的标签（服务端 tags，不扫描正文），正文默认纯文本（菜单可切 Markdown），轻点正文进编辑
  - 编辑态：正文换成输入框（text_editor），标签可 ✕ 移除 / ＋ 添加，底部一排 Markdown 工具栏 + 保存钮
  两态靠 visibility 切换，工具栏菜单与标题同步变化（见 NoteViewFragment）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inbox_bg"
    android:orientation="vertical"
    android:theme="@style/Theme.MaterialComponents">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/inbox_bg"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/inbox_text"
        app:title="查看笔记"
        app:titleTextColor="@color/inbox_text" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="24dp">

            <!-- 标签区（顶端单独显示；编辑态变成可增删） -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/inbox_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/tv_tags_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="标签"
                        android:textColor="@color/inbox_sub"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:id="@+id/tags_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/tags_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tv_tags_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="无标签"
                        android:textColor="@color/inbox_sub"
                        android:textSize="13sp" />

                    <!-- 编辑态：添加标签（弹窗里可手输或点常用标签） -->
                    <TextView
                        android:id="@+id/btn_add_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/inbox_tag_chip_bg"
                        android:clickable="true"
                        android:contentDescription="添加标签"
                        android:focusable="true"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="＋ 添加标签"
                        android:textColor="@color/inbox_accent"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 展示模式提示（同时提示轻点可编辑） -->
            <TextView
                android:id="@+id/tv_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:textColor="@color/inbox_sub"
                android:textSize="12sp" />

            <!-- 正文卡片：查看态是纯文本/渲染后的正文，编辑态是输入框 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/content_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/inbox_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:padding="14dp"
                        android:textColor="@color/inbox_text"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/editor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="top"
                        android:hint="记录点什么… 使用 #标签 标记"
                        android:imeOptions="flagNoExtractUi"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="8"
                        android:maxLines="16"
                        android:padding="14dp"
                        android:textColor="@color/inbox_text"
                        android:textColorHint="@color/inbox_sub"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:textColor="@color/inbox_sub"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 编辑态底部：Markdown 工具栏在左、保存按钮在右（键盘弹出时贴在输入法上方） -->
    <LinearLayout
        android:id="@+id/edit_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/md_toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/md_hash"
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="井号"
                    android:gravity="center"
                    android:text="#"
                    android:textColor="@color/inbox_sub"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/md_bold"
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="加粗"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="@color/inbox_sub"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/md_slash"
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="斜杠"
                    android:gravity="center"
                    android:text="/"
                    android:textColor="@color/inbox_sub"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/md_bullet"
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="无序列表"
                    android:gravity="center"
                    android:text="•"
                    android:textColor="@color/inbox_sub"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/md_ordered"
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="有序列表"
                    android:gravity="center"
                    android:text="1."
                    android:textColor="@color/inbox_sub"
                    android:textSize="15sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="保存"
            android:text="➤"
            app:backgroundTint="@color/inbox_accent" />
    </LinearLayout>
</LinearLayout>
