<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aw_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="@color/aw_bg"
            app:menu="@menu/menu_todo"
            app:title="任务"
            app:titleTextColor="@color/aw_text_primary"
            app:subtitleTextColor="@color/aw_text_secondary"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/aw_text_primary" />

        <!-- 搜索条：点工具栏 🔍 后出现（同收件箱） -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/aw_accent"
                android:hint="搜索任务…"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/aw_text_primary"
                android:textColorHint="@color/aw_text_secondary" />
        </LinearLayout>

        <!-- 视图导航：收集箱 / 今天 / 最近 7 天 / 全部 -->
        <HorizontalScrollView
            android:id="@+id/viewChipRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/viewChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 清单导航：彩色清单 chips -->
        <HorizontalScrollView
            android:id="@+id/listChipRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/listChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 标签筛选条：点任务行内的标签后出现，↑ 返回上级、✕ 清除筛选（同收件箱） -->
        <LinearLayout
            android:id="@+id/filterBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/filterUp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回上级标签"
                android:src="@drawable/ic_arrow_up"
                android:visibility="gone"
                app:tint="@color/aw_accent" />

            <TextView
                android:id="@+id/filterText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/aw_accent"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/filterClear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="清除筛选"
                android:src="@drawable/ic_x"
                app:tint="@color/aw_text_secondary" />
        </LinearLayout>

        <!-- 快速添加输入框已移除：点右下角 FAB 从底部展开输入层（同笔记页） -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- 空态（契约 §5.4） -->
            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="暂无任务\n点右下角 ＋ 添加任务"
                android:textColor="@color/aw_text_disabled"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 全局进度（契约 §5.4：已完成 X / Y，统计范围为全量而非当前视图） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:progressDrawable="@drawable/todo_progress" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/aw_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="添加任务"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/aw_accent"
        app:tint="@android:color/white" />
</FrameLayout>
